# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qualify?schema=public"

# ── Auth ───────────────────────────────────────────────────
# Secret used to sign login tokens (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Qualify"
# Public URL of the site — used for Stripe redirect links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# All prices are in US dollars (USD).

# ── Stripe payments ────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run checkout in demo mode (no real payments).
# Use the SECRET key (sk_test_…), not the publishable key (pk_test_…).
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=""
# Qualify's commission on each sale (percent). Instructors earn the rest, paid out via Stripe Connect.
PLATFORM_FEE_PERCENT="30"
